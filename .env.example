# --- Base de datos (postgres_* individuales o database_url directa) ---
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=db_name
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL=

# --- JWT ---
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Environment ---
# "development" (local) o "production" (Render)
ENVIRONMENT=development

# --- Logging ---
LOG_LEVEL=INFO

# --- Performance ---
SLOW_REQUEST_THRESHOLD_MS=500

# --- CORS (separado por comas) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_DEFAULT_BURST=10
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_AUTH_BURST=3

# Mercado Pago - Developers > Tu integración > Credenciales de prueba
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# URLs de retorno del checkout (front)
FRONTEND_SUCCESS_URL=
FRONTEND_FAILURE_URL=
FRONTEND_PENDING_URL=

# Mercado Pago - Developers > Webhooks > Configurar notificaciones
BACKEND_NOTIFICATION_URL=
MP_WEBHOOK_SECRET=
